# Local, deliberately vulnerable training application. No real payment credentials.
PORT=3000
ALICE_GATEWAY_URL=http://127.0.0.1:8001
QDS_ENGINE_URL=http://127.0.0.1:8000
# Inert value allows the untouched legacy controller to import. Never a live key.
STRIPE_SECRET_KEY=disabled_local_demo
# JWT_SECRET can be privately set; otherwise a fresh random value is generated at startup.
